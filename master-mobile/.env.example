# Copy to .env (gitignored). Loaded via String.fromEnvironment in app_config.dart
# at compile time (--dart-define-from-file=.env).

API_BASE_URL=https://master.gasimov.az/api/v1
WS_HOST=master.gasimov.az
WS_PORT=443
WS_SCHEME=wss
REVERB_APP_KEY=

GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=

# Sentry (optional)
SENTRY_DSN=

# Build flavor
APP_ENV=production
