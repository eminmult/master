# Copy to .env (gitignored). These are *build-time* args consumed by the
# Dockerfile via `ARG` and then injected into the Flutter bundle through
# `--dart-define=KEY=...`. Re-read at runtime via String.fromEnvironment
# in lib/core/api_client/urls.dart.

# REST API base. Production points at itez.app; for staging override here.
API_BASE_URL=https://itez.app/api/v1

# Site root for cross-links (terms, privacy, share targets).
SITE_URL=https://itez.app

# Reverb (Laravel WebSockets) — realtime channel transport.
REVERB_HOST=ws.itez.app
REVERB_KEY=
REVERB_PORT=443

# Where the bundle is served from under nginx. The site mounts v2 at
# /master-mobile-v2/, so BASE_HREF must match that path (trailing slash).
BASE_HREF=/master-mobile-v2/
