APP_NAME=Master
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://itez.app

APP_LOCALE=az
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=az_AZ

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=master-db
DB_PORT=5432
DB_DATABASE=master_db
DB_USERNAME=master_user
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=master-redis
REDIS_PASSWORD=
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=itez.app
FRONTEND_URL=https://itez.app

# Mail (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@itez.app"
MAIL_FROM_NAME="${APP_NAME}"

# SMS (provider stub for launch — keep empty to log only)
SMS_PROVIDER=log
SMS_TWILIO_SID=
SMS_TWILIO_TOKEN=
SMS_TWILIO_FROM=

# Master subscription (false = launch mode, all masters active)
MASTER_SUBSCRIPTION_REQUIRED=false
MASTER_REGISTRATION_FEE=0
MASTER_MONTHLY_FEE=0
MASTER_FREE_LAUNCH_UNTIL=2026-12-31

# Reverb broadcast
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

# Gemini (auto-translation)
GEMINI_API_KEY=

# Sentry
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
