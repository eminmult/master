# Copy to .env (gitignored). Read by server.js at boot.

# Port the SSE relay listens on. Behind nginx as /events/.
SSE_PORT=8086

# Redis pub/sub. Backend publishes to channels, SSE relay subscribes
# and fans out to connected clients via Server-Sent Events.
REDIS_URL=redis://default:redispass@master-redis:6379

# Internal Laravel API URL used for token validation. The relay calls
# /api/sse/auth with the client's bearer token before opening the stream.
API_INTERNAL_URL=http://master-api:8000/api
