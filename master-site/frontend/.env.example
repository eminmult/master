# Copy to .env (gitignored). All keys are read by nuxt.config.ts via
# runtimeConfig.public and exposed to the client bundle.

# Backend API. Local dev uses host-mapped Laravel container.
NUXT_PUBLIC_API_BASE=http://localhost:8093/api
NUXT_PUBLIC_WS_URL=ws://localhost:8093

# Reverb (Laravel WebSockets). In production these point at realtime.itez.app.
NUXT_PUBLIC_REVERB_KEY=
NUXT_PUBLIC_REVERB_HOST=realtime.itez.app
NUXT_PUBLIC_REVERB_PORT=443
NUXT_PUBLIC_REVERB_SCHEME=https

# Maps. Empty = map widgets render without an API key (rate-limited tile fallback).
NUXT_PUBLIC_GOOGLE_MAPS_KEY=
